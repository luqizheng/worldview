<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库级 NuGet 源策略 —— 强制本工程的所有 restore/build 只走 nuget.org。

  写入理由（响应用户 m00134 "麻烦写入规则中，避免每次都出现同样得问题"）：
  * `Godot.NET.Sdk/4.7.2` 是 NuGet 风格 project SDK，由
    `Microsoft.Build.NuGetSdkResolver` 解析。该解析器会沿配置链加载所有
    `<packageSources>`，并在第一个可达源里命中目标。如果非 nuget.org 源
    排在 nuget.org 之前或并行存在，解析器仍会按顺序尝试私有 feed，
    命中 MSB4276（"默认 SDK 解析程序解析 SDK Godot.NET.Sdk 失败"）。
  * 用户机器级 NuGet.Config（C:\Users\leo\AppData\Roaming\NuGet\NuGet.Config）
    仍保留 `coder`（nuget.kudi.repos）与 `coder2`（192.168.2.12:15555）
    两个私有 feed。仓库级 `<clear />` 已清空 packageSources，restore 不再
    使用它们；但配置链是叠加的，把它们显式列入 `disabledPackageSources`
    是防御性兜底 —— 即使未来有人手抖把私有源加回，或机器级配置变更，
    restore 也会跳过它们。
  * `nuget.org` 加 `protocolVersion="3"` 是 NuGet 6+ 推荐的现代协议版本。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    <!-- 显式禁用已知的私有 feed，防止它们被配置链注入回本工程的 restore -->
    <add key="coder" value="true" />
    <add key="coder2" value="true" />
  </disabledPackageSources>
</configuration>
