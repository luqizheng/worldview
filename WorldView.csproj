<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>WorldView</RootNamespace>
    <AssemblyName>WorldView</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Godot.NET.Sdk 4.7.2 默认会把仓库内所有 *.cs 都纳入编译（含 tests/ 与 obj/、bin/）。
      本工程只编译 scripts/ 下源码；tests/ 由独立 csproj 编译。
      obj/bin 是构建产物,绝不能让主项目纳入。
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="scripts/**/*.cs" />
    <!--
      显式列出 Theme/Palette.cs:MSBuild glob 在某些环境下不匹配该文件。
      它的存在对 Generator 至关重要,不能丢。
    -->
    <Compile Include="scripts/Ui/Theme/Palette.cs" />
    <!--
      scripts/Generator 是源生成器项目,只由独立 csproj 编译并通过 ProjectReference
      OutputItemType=Analyzer 引入分析器。绝不能让主项目直接编译它(否则 Generator.dll
      还没生成,它内部的 Roslyn API 类型也找不到)。
    -->
    <Compile Remove="scripts/Generator/**/*.cs" />
    <Compile Remove="scripts\Generator\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)scripts\Generator\bin\$(Configuration)\net8.0\WorldView.Generator.dll" />
    <!--
      AdditionalFiles 路径是相对 WorldView.csproj 所在目录的(不是 sln 根)。
      Godot 项目内 assets/ 在 WorldView.csproj 旁,直接用相对路径。
    -->
    <AdditionalFiles Include="assets\palettes\parchment_palette.yaml" />
  </ItemGroup>

  <Target Name="EnsureGeneratorBuilt" BeforeTargets="CoreCompile" Condition="'$(SkipGeneratorBuild)' != 'true'">
    <PropertyGroup>
      <GeneratorProjectPath>$(MSBuildThisFileDirectory)scripts\Generator\WorldView.Generator.csproj</GeneratorProjectPath>
    </PropertyGroup>
    <Message Text="==> EnsureGeneratorBuilt: building $(GeneratorProjectPath)" Importance="high" />
    <MSBuild Projects="$(GeneratorProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
