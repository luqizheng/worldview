<Project>

  <!--
    World View 新架构工程统一构建配置。
    所有项目的公共属性集中在此维护；各 csproj 只保留自身差异项，避免多份事实来源。
  -->

  <PropertyGroup>
    <!-- 统一目标框架：.NET 11 STS（SDK 11.0.100+；Microsoft 支持至 2028-11-14，需持续安装月度补丁） -->
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Product>World View</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
