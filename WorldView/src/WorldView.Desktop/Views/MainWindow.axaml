<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WorldView.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="560"
        x:Class="WorldView.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="World View" Width="880" Height="560" MinWidth="640" MinHeight="480">

    <!-- 基础布局基线：菜单栏 + 内容区 + 状态栏。地图画布等业务区域后续阶段实现。 -->

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建示例项目(_N)" Command="{Binding CreateSampleProjectCommand}" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="编辑(_E)" IsEnabled="False" />
            <MenuItem Header="视图(_V)" IsEnabled="False" />
            <MenuItem Header="帮助(_H)" IsEnabled="False" />
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="12,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Text="World View" />
            <TextBlock FontSize="14" HorizontalAlignment="Center" Opacity="0.7"
                       Text="专业地图编辑与 AI 辅助制图桌面应用 — 工程初始化基线 v0.1.0" />
            <Button Margin="0,20,0,0" HorizontalAlignment="Center"
                    Command="{Binding CreateSampleProjectCommand}" Content="创建示例项目" />
            <TextBlock HorizontalAlignment="Center" Opacity="0.8" Text="{Binding LastCreatedProjectName}" />
        </StackPanel>
    </DockPanel>
</Window>
