<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WorldView.Desktop.ViewModels"
        xmlns:app="using:WorldView.Application.Abstractions"
        xmlns:session="using:WorldView.Application.Sessions"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="WorldView.Desktop.Views.ProjectWindow"
        x:DataType="vm:ProjectWorkspaceViewModel"
        Title="World View — 项目工作区" Width="1240" Height="800" MinWidth="1040" MinHeight="680">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="eyebrow" Text="WORLD PROJECT" />
                    <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ProjectDisplayName}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding ProjectId}" />
                </StackPanel>
                <Menu Grid.Column="1" VerticalAlignment="Center">
                    <MenuItem Header="文件">
                        <MenuItem Header="关闭项目" Command="{Binding CloseProjectCommand}" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="18" Margin="20">
            <!-- The map list consumes only the space left after its header and actions.
                 The local-project footer is a sibling row and therefore cannot be pushed off-screen. -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="14">
                <Border Grid.Row="0" Classes="surface-card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="eyebrow" Text="PROJECT CONTENT" />
                            <TextBlock Classes="section-title" Text="地图" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="项目中的世界地图与区域。" />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:MapSummary">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="34" Height="34" CornerRadius="7"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="⌖" FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="世界地图" FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="{Binding MapsStatusText}" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        <Button Grid.Row="3" Classes="primary" Content="＋  创建地图" Click="OnCreateMapClick" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Classes="subtle-panel">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="eyebrow" Text="LOCAL WORKSPACE" />
                        <TextBlock Text="项目数据保存在本机。" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="eyebrow" Text="EDITOR WORKSPACES" />
                        <TextBlock Classes="page-title" Text="工作区" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   Text="打开地图工作区，开始构建和编辑你的世界。" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center"
                            Content="打开地图工作区" Command="{Binding OpenWorkspaceCommand}" />
                </Grid>

                <Border Grid.Row="1" Classes="surface-card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section-title" Text="已打开的工作区" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding Workspaces.Count}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="session:MapWorkspaceSession">
                                        <Border CornerRadius="8" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="42" Height="42" CornerRadius="8"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="▦" FontSize="21"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{Binding Context.MapId, StringFormat='地图 {0}'}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="地图编辑会话" FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="打开" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- WP-30B Phase 3A：选中工作区的视口宿主（M1 单视口；内容由 code-behind 按
                             SelectedWorkspace 挂载 MapViewportControl，生命周期接线见 ADR-10）。 -->
                        <Border Grid.Row="2" MinHeight="140"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="2">
                            <ContentControl x:Name="ViewportHost" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="关闭所选工作区" Command="{Binding CloseWorkspaceCommand}" />
                            <Button Classes="primary" Content="关闭项目" Command="{Binding CloseProjectCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,9">
            <TextBlock Text="{Binding WorkspaceStatusText}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>