<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WorldView.Desktop.ViewModels"
        xmlns:app="using:WorldView.Application.Abstractions"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
        x:Class="WorldView.Desktop.Views.StartWindow"
        x:DataType="vm:StartViewModel"
        Title="World View" Width="1040" Height="720" MinWidth="900" MinHeight="620"
        CanResize="True">

    <Grid ColumnDefinitions="248,*">
        <!-- Product navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="22,24">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="23" FontWeight="Bold" Text="WORLD VIEW" />
                    <TextBlock Classes="eyebrow" Text="WORLD BUILDING STUDIO" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="8">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="▦" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="项目中心" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="eyebrow" Margin="12,24,0,4" Text="工作区" />
                    <TextBlock Margin="12,4" Foreground="{DynamicResource MutedTextBrush}" Text="最近项目" />
                    <TextBlock Margin="12,4" Foreground="{DynamicResource MutedTextBrush}" Text="地图与场景" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="4">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <TextBlock Classes="eyebrow" Text="LOCAL PROJECTS" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Text="项目数据保存在本机" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="34,22"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="eyebrow" Text="PROJECT HOME" />
                        <TextBlock Classes="page-title" Text="项目中心" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   Text="创建一个新世界，或继续上次的创作。" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Classes="subtle-panel" Padding="12,8">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="离线优先 · 本地项目" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="34,28">
                <StackPanel Spacing="22">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Classes="surface-card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="eyebrow" Text="START A WORLD" />
                                <TextBlock Classes="section-title" Text="创建新项目" />
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="建立独立的世界项目包，所有内容保存在你选择的位置。"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding NewProjectName}" PlaceholderText="输入项目名称" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button x:Name="ChooseCreateLocationButton" Content="选择保存位置…" Click="OnChooseCreateLocationClick" />
                                    <Button Grid.Column="1" Classes="primary" Content="创建项目"
                                            Command="{Binding CreateProjectCommand}"
                                            IsEnabled="{Binding CreateParentDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding CreateParentDirectory, StringFormat='保存位置：{0}', FallbackValue='保存位置：尚未选择'}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="surface-card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="eyebrow" Text="OPEN EXISTING" />
                                <TextBlock Classes="section-title" Text="打开已有项目" />
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="选择本机上的 .wvproject 项目包目录，继续已有创作。"
                                           TextWrapping="Wrap" />
                                <Border Classes="subtle-panel" MinHeight="48">
                                    <TextBlock Text="{Binding SelectedPackagePath, FallbackValue='尚未选择项目包'}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button x:Name="ChoosePackageButton" Content="浏览项目包…" Click="OnChoosePackageClick" />
                                    <Button Grid.Column="1" Classes="primary" Content="打开项目"
                                            Command="{Binding OpenProjectCommand}"
                                            IsEnabled="{Binding SelectedPackagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="surface-card">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="eyebrow" Text="CONTINUE CREATING" />
                                    <TextBlock Classes="section-title" Text="最近项目" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                           Text="{Binding RecentProjects.Count}" />
                            </Grid>
                            <Grid Grid.Row="1" MinHeight="150">
                                <ListBox x:Name="RecentList" ItemsSource="{Binding RecentProjects}"
                                         SelectedItem="{Binding SelectedRecentItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="app:RecentProjectEntry">
                                            <Border CornerRadius="7" Padding="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Border Width="38" Height="38" CornerRadius="8"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="▧" FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Text="{Binding PackagePath}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                   Text="{Binding LastOpenedAtUtc, StringFormat='最近打开：{0:yyyy-MM-dd HH:mm} UTC'}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <Button Grid.Row="2" HorizontalAlignment="Right"
                                    Content="打开所选项目"
                                    Command="{Binding OpenRecentCommand}"
                                    CommandParameter="{Binding SelectedRecentItem}" />
                        </Grid>
                    </Border>

                    <Border Classes="subtle-panel">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>