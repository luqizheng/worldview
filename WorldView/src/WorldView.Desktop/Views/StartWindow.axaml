<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WorldView.Desktop.ViewModels"
        xmlns:app="using:WorldView.Application.Abstractions"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="460"
        x:Class="WorldView.Desktop.Views.StartWindow"
        x:DataType="vm:StartViewModel"
        Title="World View" Width="680" Height="460" MinWidth="560" MinHeight="400"
        CanResize="True">

    <!-- 启动面（AF-01 §4.1）：创建项目 / 打开项目 / 最近项目。地图画布属于 PRA-01/PRA-02 之后的阶段。 -->

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Padding="24,20">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock FontSize="26" FontWeight="Bold" Text="World View" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7"
                               Text="本地优先的世界构建与地图编辑桌面应用" />
                </StackPanel>

                <Separator />

                <!-- 创建项目 -->
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="创建项目" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="220" Watermark="项目名称" Text="{Binding NewProjectName}" />
                        <Button x:Name="ChooseCreateLocationButton" Content="选择保存位置…" Click="OnChooseCreateLocationClick" />
                        <Button Content="创建项目包"
                                Command="{Binding CreateProjectCommand}"
                                IsEnabled="{Binding CreateParentDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Opacity="0.7" Text="{Binding CreateParentDirectory, StringFormat='保存到：{0}', FallbackValue='保存到：（未选择）'}" />
                </StackPanel>

                <Separator />

                <!-- 打开项目 -->
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="打开项目" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChoosePackageButton" Content="选择 .wvproject 包目录…" Click="OnChoosePackageClick" />
                        <Button Content="打开"
                                Command="{Binding OpenProjectCommand}"
                                IsEnabled="{Binding SelectedPackagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Opacity="0.7" Text="{Binding SelectedPackagePath, FallbackValue='（未选择）'}" />
                </StackPanel>

                <Separator />

                <!-- 最近项目 -->
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="最近项目" />
                    <ListBox x:Name="RecentList" ItemsSource="{Binding RecentProjects}" Height="120"
                             SelectedItem="{Binding SelectedRecentItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="app:RecentProjectEntry">
                                <StackPanel>
                                    <TextBlock Text="{Binding PackagePath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Opacity="0.6" FontSize="11"
                                               Text="{Binding LastOpenedAtUtc, StringFormat='最近打开：{0:yyyy-MM-dd HH:mm} (UTC)'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="打开所选项目"
                            Command="{Binding OpenRecentCommand}"
                            CommandParameter="{Binding SelectedRecentItem}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
