<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- XAML 编译绑定默认开启，绑定错误在编译期暴露 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldView.Application\WorldView.Application.csproj" />
    <ProjectReference Include="..\WorldView.Presentation\WorldView.Presentation.csproj" />
    <ProjectReference Include="..\WorldView.Infrastructure\WorldView.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    WP-30B Phase 3A：视口生命周期类型（MapViewportBinding 等）为 Desktop 内部具体类，
    按 ADR-07 约束 7 不实现接口、不注册 DI；生命周期测试经 InternalsVisibleTo 访问
    （与 Application / Presentation 的既有授权模式一致）。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="WorldView.Desktop.Tests" />
  </ItemGroup>

</Project>
