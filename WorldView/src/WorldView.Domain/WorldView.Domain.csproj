<Project Sdk="Microsoft.NET.Sdk">

  <!-- 核心领域层：不依赖 UI、桌面平台 API 或持久化框架；Field Package 使用独立 RFC 8785 规范化库。 -->

  <!--
    Registry descriptor 目录（CD-02-C）：以仓库内正式文档 P2-09-26 V0.2 为唯一数据源
    经链接嵌入为程序集资源（避免复制件漂移）；运行时由 ObjectTypeRegistry 解析并
    fail-closed 校验。资源嵌入不产生对 docs 的运行时依赖。
    CD-02-E：Building/Cave 采纳扩展（P2-09-41 V0.4 descriptor 扩展 + P2-09-38/39 V0.5
    聚合 schema）同样以链接资源嵌入，作为采纳包的运行时输入。
  -->
  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\docs\architecture\core-domain\p2-09-26-v1-object-type-descriptor-registry-v0.2.json"
      Link="Registry\p2-09-26-v1-object-type-descriptor-registry-v0.2.json" />
    <EmbeddedResource
      Include="..\..\..\docs\architecture\core-domain\p2-09-41-building-cave-object-type-descriptor-extension-v0.4.json"
      Link="Registry\p2-09-41-building-cave-object-type-descriptor-extension-v0.4.json" />
    <EmbeddedResource
      Include="..\..\..\docs\architecture\core-domain\p2-09-38-building-typed-aggregate-schema-v0.5.json"
      Link="Registry\p2-09-38-building-typed-aggregate-schema-v0.5.json" />
    <EmbeddedResource
      Include="..\..\..\docs\architecture\core-domain\p2-09-39-cave-system-typed-aggregate-schema-v0.5.json"
      Link="Registry\p2-09-39-cave-system-typed-aggregate-schema-v0.5.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MackySoft.Json.Canonicalization" Version="0.1.0" />
  </ItemGroup>

  <!--
    Task 002-B：AssetByteDigest.MeasureAsync 为 internal，摘要创建能力只授予
    真实字节验证路径（WorldView.Application 的 VerifyAssetIntegrityUseCase）。
    两个测试程序集仅用于摘要行为与 API Surface 锁定测试，非生产入口；
    本声明不产生工程引用，Domain 仍不依赖 Application/Infrastructure。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="WorldView.Application" />
    <InternalsVisibleTo Include="WorldView.Domain.Tests" />
    <InternalsVisibleTo Include="WorldView.Infrastructure.Tests" />
  </ItemGroup>

</Project>
