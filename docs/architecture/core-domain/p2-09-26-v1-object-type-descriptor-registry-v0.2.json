  "authority": "Core Domain static registry",
  "common_rules": {
    "stable_identity": "One stable type_key per Object; non-localized and never reused.",
    "scopes": [
      "definition",
      "initial_state",
      "history_runtime"
    ],
    "definition": "Current shared/base definition; retroactive under accepted current-definition model.",
    "initial_state": "Map time-zero baseline; not a post-zero Command.",
    "history_runtime": "Map/Branch-local; changed only by declared deterministic Commands.",
    "unknown_fields": "reject",
    "geometry": "Immutable Asset-backed Geometry Components; this registry declares roles/cardinality/families only.",
    "references": "Stable IDs, never display names or filesystem paths.",
    "shared_definition_edit": {
      "authority": "Shared Object definition Domain Service, not core.object.attribute.change",
      "scope": "Project-shared current definition; retroactive for every referencing Map/Branch",
      "map_local_definition": "Owner-Map definition service",
      "history_runtime": "Only declared runtime mutable fields may be changed by a selected-History Command",
      "initial_state": "Map-specific time-zero membership, placement and initial runtime values use Initial State authoring"
    },
    "object_creation": "core.object.create introduces presence of an already Bound Object identity into the selected post-zero History; reservation/binding and definition ownership are separate.",
    "command_capability_shape": "Each command_capabilities entry is a structured policy object."
  },
