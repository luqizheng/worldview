{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-view.local/schemas/field-package-manifest-v1.schema.json",
  "title": "World View Field Package Canonical Manifest V1",
  "description": "Strict V1 manifest shape; descriptor and cross-field checks are additionally enforced by Core Domain and the package reader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "byte_order",
    "canonicalization",
    "codec_registry",
    "coverage",
    "field",
    "format",
    "grid",
    "manifest_schema",
    "map_edge_semantics",
    "no_data",
    "spatial",
    "tile_hash",
    "value_encoding"
  ],
  "properties": {
    "byte_order": {
      "const": "little_endian"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "world-view.field-package-manifest"
        },
        "version": {
          "const": 1
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_key",
        "schema_version",
        "semantics_id"
      ],
      "properties": {
        "field_key": {
          "enum": [
            "elevation",
            "land_water"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "semantics_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_space_id",
        "spatial_reference_id"
      ],
      "properties": {
        "map_space_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "spatial_reference_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "tile_width",
        "tile_height",
        "origin_x",
        "origin_y",
        "spacing_x",
        "spacing_y",
        "axis_orientation",
        "cell_registration"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tile_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tile_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "origin_x": {
          "$ref": "#/$defs/decimalString"
        },
        "origin_y": {
          "$ref": "#/$defs/decimalString"
        },
        "spacing_x": {
          "$ref": "#/$defs/positiveDecimalString"
        },
        "spacing_y": {
          "$ref": "#/$defs/positiveDecimalString"
        },
        "axis_orientation": {
          "enum": [
            "x_east_y_north",
            "x_east_y_south",
            "x_west_y_north",
            "x_west_y_south"
          ]
        },
        "cell_registration": {
          "enum": [
            "area",
            "point"
          ]
        }
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "full_grid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "mask_plane_name"
          ],
          "properties": {
            "mode": {
              "const": "explicit_mask"
            },
            "mask_plane_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      ]
    },
    "map_edge_semantics": {
      "enum": [
        "bounded_non_wrapping",
        "wrap_x",
        "wrap_y",
        "wrap_xy",
        "unknown"
      ]
    },
    "no_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "mask_plane"
      ],
      "properties": {
        "policy": {
          "const": "explicit_validity_mask"
        },
        "mask_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plane_name",
            "valid_value",
            "invalid_value"
          ],
          "properties": {
            "plane_name": {
              "const": "validity_mask"
            },
            "valid_value": {
              "const": 0
            },
            "invalid_value": {
              "const": 1
            }
          }
        }
      }
    },
    "value_encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_scope",
        "planes"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "profile_scope": {
          "enum": [
            "golden_fixture_only",
            "production"
          ]
        },
        "planes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sample_format",
              "bytes_per_cell"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "sample_format": {
                "enum": [
                  "uint8",
                  "uint8_registered_category",
                  "int16_le",
                  "uint16_le",
                  "int32_le",
                  "uint32_le",
                  "float32_ieee754_le",
                  "float64_ieee754_le"
                ]
              },
              "bytes_per_cell": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            }
          }
        },
        "category_codes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "land",
            "water",
            "unknown",
            "outside_coverage"
          ],
          "properties": {
            "land": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "water": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "outside_coverage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    },
    "codec_registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codec_id",
          "codec_name",
          "version",
          "parameters"
        ],
        "properties": {
          "codec_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "codec_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "tile_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "version": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*|-?0\\.[0-9]*[1-9]|-[1-9][0-9]*\\.[0-9]*[1-9])$"
    },
    "positiveDecimalString": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0\\.[0-9]*[1-9]|[1-9][0-9]*(\\.[0-9]*[1-9])?)$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "field": {
            "properties": {
              "field_key": {
                "const": "land_water"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "value_encoding": {
            "required": [
              "category_codes"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field": {
            "properties": {
              "field_key": {
                "const": "elevation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "value_encoding": {
            "not": {
              "required": [
                "category_codes"
              ]
            }
          }
        }
      }
    }
  ]
}
