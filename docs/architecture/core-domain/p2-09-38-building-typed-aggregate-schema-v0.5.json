{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-view:core-domain:building-definition:5",
  "title": "World View Building Definition Payload V0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_name",
    "building_class",
    "horizontal_frame",
    "vertical_frame",
    "levels",
    "spaces",
    "plans",
    "boundaries",
    "access",
    "geometry_components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "building_class": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "industrial",
        "institutional",
        "religious",
        "military",
        "transport",
        "utility",
        "mixed_use",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "horizontal_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "coordinate_kind",
        "unit",
        "origin",
        "orientation_degrees",
        "precision_profile_id"
      ],
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/id"
        },
        "coordinate_kind": {
          "const": "local_cartesian"
        },
        "unit": {
          "type": "string",
          "enum": [
            "m",
            "ft"
          ]
        },
        "origin": {
          "$ref": "#/$defs/point2"
        },
        "orientation_degrees": {
          "type": "number"
        },
        "precision_profile_id": {
          "$ref": "#/$defs/id"
        },
        "map_binding": {
          "$ref": "#/$defs/horizontal_binding"
        }
      }
    },
    "vertical_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical_frame_id",
        "unit",
        "positive_axis",
        "precision_profile_id"
      ],
      "properties": {
        "vertical_frame_id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "type": "string",
          "enum": [
            "m",
            "ft"
          ]
        },
        "positive_axis": {
          "const": "up"
        },
        "precision_profile_id": {
          "$ref": "#/$defs/id"
        },
        "map_binding": {
          "$ref": "#/$defs/vertical_binding"
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "access": {
      "$ref": "#/$defs/access"
    },
    "geometry_components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geometry_component"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "horizontal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spatial_reference_id",
        "transform_id",
        "transform_version"
      ],
      "properties": {
        "spatial_reference_id": {
          "$ref": "#/$defs/id"
        },
        "transform_id": {
          "$ref": "#/$defs/id"
        },
        "transform_version": {
          "type": "integer",
          "minimum": 1
        },
        "max_error": {
          "type": "number",
          "minimum": 0
        },
        "error_unit": {
          "type": "string",
          "enum": [
            "m",
            "ft",
            "map_unit"
          ]
        }
      }
    },
    "vertical_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical_reference_id",
        "transform_id",
        "transform_version"
      ],
      "properties": {
        "vertical_reference_id": {
          "$ref": "#/$defs/id"
        },
        "transform_id": {
          "$ref": "#/$defs/id"
        },
        "transform_version": {
          "type": "integer",
          "minimum": 1
        },
        "max_error": {
          "type": "number",
          "minimum": 0
        },
        "error_unit": {
          "type": "string",
          "enum": [
            "m",
            "ft"
          ]
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level_id",
        "level_label",
        "level_kind",
        "display_order",
        "status"
      ],
      "properties": {
        "level_id": {
          "$ref": "#/$defs/id"
        },
        "level_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "level_kind": {
          "type": "string",
          "enum": [
            "basement",
            "ground",
            "storey",
            "mezzanine",
            "attic",
            "roof",
            "platform",
            "other"
          ]
        },
        "display_order": {
          "type": "integer"
        },
        "elevation_local": {
          "type": "number"
        },
        "vertical_extent_local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "is_primary_access_level": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space_id",
        "space_kind",
        "status"
      ],
      "properties": {
        "space_id": {
          "$ref": "#/$defs/id"
        },
        "space_kind": {
          "type": "string",
          "enum": [
            "room",
            "corridor",
            "lobby",
            "atrium",
            "stairwell",
            "shaft",
            "service_space",
            "void",
            "open_area",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "intended_use": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "completeness",
        "level_slices"
      ],
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "conceptual"
          ]
        },
        "level_slices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level_slice"
          }
        }
      }
    },
    "level_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "space_id",
        "level_id",
        "boundary_geometry_component_ids",
        "region_geometry_component_ids"
      ],
      "properties": {
        "slice_id": {
          "$ref": "#/$defs/id"
        },
        "space_id": {
          "$ref": "#/$defs/id"
        },
        "level_id": {
          "$ref": "#/$defs/id"
        },
        "vertical_span_local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "region_geometry_component_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "boundary_geometry_component_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "boundary_kind",
        "geometry_component_id",
        "participating_space_ids"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/id"
        },
        "boundary_kind": {
          "type": "string",
          "enum": [
            "partition",
            "exterior_boundary",
            "virtual_boundary",
            "open_edge",
            "unknown"
          ]
        },
        "participating_space_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "geometry_component_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrances",
        "openings",
        "connections",
        "vertical_connectors",
        "exterior_anchors"
      ],
      "properties": {
        "entrances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entrance"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "vertical_connectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vertical_connector"
          }
        },
        "exterior_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exterior_anchor"
          }
        }
      }
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrance_id",
        "entrance_kind"
      ],
      "properties": {
        "entrance_id": {
          "$ref": "#/$defs/id"
        },
        "entrance_kind": {
          "type": "string",
          "enum": [
            "main",
            "secondary",
            "service",
            "emergency",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "anchor_geometry_component_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening_id",
        "opening_kind",
        "boundary_id",
        "anchor"
      ],
      "properties": {
        "opening_id": {
          "$ref": "#/$defs/id"
        },
        "opening_kind": {
          "type": "string",
          "enum": [
            "door",
            "archway",
            "passage",
            "window",
            "hatch",
            "service_opening",
            "other"
          ]
        },
        "boundary_id": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "geometry_component_id",
            "source_content_hash",
            "parameter_start",
            "parameter_end"
          ],
          "properties": {
            "parameter_start": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "parameter_end": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "geometry_component_id": {
              "$ref": "#/$defs/id"
            },
            "source_content_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "space_id"
          ],
          "properties": {
            "kind": {
              "const": "space"
            },
            "space_id": {
              "$ref": "#/$defs/id"
            },
            "level_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entrance_id"
          ],
          "properties": {
            "kind": {
              "const": "entrance"
            },
            "entrance_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor_id"
          ],
          "properties": {
            "kind": {
              "const": "exterior_anchor"
            },
            "anchor_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_connection_id",
        "connection_kind",
        "endpoints",
        "direction"
      ],
      "properties": {
        "access_connection_id": {
          "$ref": "#/$defs/id"
        },
        "connection_kind": {
          "type": "string",
          "enum": [
            "doorway",
            "open_passage",
            "archway",
            "hatch_access",
            "other_explicit"
          ]
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "direction": {
          "type": "string",
          "enum": [
            "bidirectional",
            "a_to_b",
            "b_to_a",
            "unknown"
          ]
        },
        "opening_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "connector_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level_id"
      ],
      "properties": {
        "level_id": {
          "$ref": "#/$defs/id"
        },
        "space_id": {
          "$ref": "#/$defs/id"
        },
        "landing_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "vertical_connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical_connector_id",
        "connector_kind",
        "stops",
        "direction"
      ],
      "properties": {
        "vertical_connector_id": {
          "$ref": "#/$defs/id"
        },
        "connector_kind": {
          "type": "string",
          "enum": [
            "stair",
            "elevator",
            "ladder",
            "ramp",
            "other_explicit"
          ]
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connector_stop"
          },
          "minItems": 2
        },
        "direction": {
          "type": "string",
          "enum": [
            "bidirectional",
            "ascending_only",
            "descending_only",
            "unknown"
          ]
        }
      }
    },
    "geometry_component": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/geometry_component_base"
            },
            {
              "type": "object",
              "properties": {
                "geometry_family": {
                  "type": "string",
                  "enum": [
                    "polygon",
                    "multi_polygon"
                  ]
                },
                "child_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "maxProperties": 0
                },
                "geometry_role": {
                  "const": "footprint"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/geometry_component_base"
            },
            {
              "type": "object",
              "properties": {
                "geometry_family": {
                  "type": "string",
                  "enum": [
                    "polygon",
                    "multi_polygon"
                  ]
                },
                "child_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "space_id",
                    "level_id",
                    "slice_id"
                  ],
                  "properties": {
                    "space_id": {
                      "$ref": "#/$defs/id"
                    },
                    "level_id": {
                      "$ref": "#/$defs/id"
                    },
                    "slice_id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                },
                "geometry_role": {
                  "const": "space_region"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/geometry_component_base"
            },
            {
              "type": "object",
              "properties": {
                "geometry_family": {
                  "type": "string",
                  "enum": [
                    "line_string",
                    "multi_line_string"
                  ]
                },
                "child_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "boundary_id"
                  ],
                  "properties": {
                    "boundary_id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                },
                "geometry_role": {
                  "const": "boundary"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/geometry_component_base"
            },
            {
              "type": "object",
              "properties": {
                "geometry_family": {
                  "type": "string",
                  "enum": [
                    "line_string",
                    "multi_line_string"
                  ]
                },
                "child_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "boundary_id"
                  ],
                  "properties": {
                    "boundary_id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                },
                "geometry_role": {
                  "const": "partition_annotation"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/geometry_component_base"
            },
            {
              "type": "object",
              "properties": {
                "geometry_family": {
                  "const": "point"
                },
                "child_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entrance_id"
                  ],
                  "properties": {
                    "entrance_id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                },
                "geometry_role": {
                  "const": "entrance_anchor"
                }
              }
            }
          ]
        }
      ]
    },
    "exterior_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "anchor_kind",
        "coordinate_context_id"
      ],
      "properties": {
        "anchor_id": {
          "$ref": "#/$defs/id"
        },
        "anchor_kind": {
          "type": "string",
          "enum": [
            "map_anchor",
            "building_boundary_anchor",
            "site_anchor"
          ]
        },
        "coordinate_context_id": {
          "$ref": "#/$defs/id"
        },
        "geometry_component_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "geometry_component_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_component_id",
        "geometry_role",
        "geometry_family",
        "dimension",
        "coordinate_context_id",
        "child_context",
        "asset_id",
        "content_hash",
        "spatial_reference_id",
        "geometry_schema_version",
        "provenance",
        "validity_metadata"
      ],
      "properties": {
        "geometry_family": {
          "type": "string"
        },
        "dimension": {
          "const": 2
        },
        "coordinate_context_id": {
          "$ref": "#/$defs/id"
        },
        "child_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "space_id": {
              "$ref": "#/$defs/id"
            },
            "level_id": {
              "$ref": "#/$defs/id"
            },
            "slice_id": {
              "$ref": "#/$defs/id"
            },
            "boundary_id": {
              "$ref": "#/$defs/id"
            },
            "entrance_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "geometry_component_id": {
          "$ref": "#/$defs/id"
        },
        "geometry_role": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "spatial_reference_id": {
          "$ref": "#/$defs/id"
        },
        "geometry_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provenance": {
          "$ref": "#/$defs/geometry_provenance"
        },
        "validity_metadata": {
          "$ref": "#/$defs/geometry_validity_metadata"
        }
      }
    },
    "geometry_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "authored",
            "imported",
            "refined",
            "ai_generated",
            "adopted_derived"
          ]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "geometry_validity_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validation_profile_id",
        "issue_codes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "warning",
            "indeterminate"
          ]
        },
        "validation_profile_id": {
          "type": "string",
