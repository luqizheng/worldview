{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-view:core-domain:cave-system-definition:1",
  "title": "World View Cave System Definition Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_name",
    "cave_class",
    "survey_completeness",
    "survey_frames",
    "chambers",
    "passages",
    "entrances",
    "survey_stations",
    "connections",
    "geometry_components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cave_class": {
      "type": "string",
      "enum": [
        "limestone",
        "lava_tube",
        "sea_cave",
        "ice_cave",
        "mine_modified_cave",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "survey_completeness": {
      "type": "string",
      "enum": [
        "partial",
        "substantially_surveyed",
        "declared_complete"
      ]
    },
    "survey_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/survey_frame"
      },
      "minItems": 1
    },
    "chambers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chamber"
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passage"
      }
    },
    "entrances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrance"
      }
    },
    "survey_stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "geometry_components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geometry_component"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "survey_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_frame_id",
        "horizontal_context_kind",
        "horizontal_context_id",
        "unit",
        "precision_profile_id",
        "survey_method",
        "frame_version"
      ],
      "properties": {
        "survey_frame_id": {
          "$ref": "#/$defs/id"
        },
        "horizontal_context_kind": {
          "type": "string",
          "enum": [
            "map_reference",
            "cave_local_cartesian"
          ]
        },
        "horizontal_context_id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "type": "string",
          "enum": [
            "m",
            "ft"
          ]
        },
        "vertical_reference_id": {
          "$ref": "#/$defs/id"
        },
        "local_vertical_origin": {
          "type": "number"
        },
        "positive_axis": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "precision_profile_id": {
          "$ref": "#/$defs/id"
        },
        "survey_method": {
          "type": "string",
          "enum": [
            "manual_survey",
            "instrument_survey",
            "imported_survey",
            "interpreted",
            "unknown"
          ]
        },
        "frame_version": {
          "type": "integer",
          "minimum": 1
        },
        "provenance_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "chamber": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chamber_id",
        "chamber_kind",
        "status",
        "survey_confidence"
      ],
      "properties": {
        "chamber_id": {
          "$ref": "#/$defs/id"
        },
        "chamber_kind": {
          "type": "string",
          "enum": [
            "chamber",
            "shaft_room",
            "gallery",
            "void",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        },
        "survey_confidence": {
          "type": "string",
          "enum": [
            "measured",
            "estimated",
            "interpreted",
            "unknown"
          ]
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passage_id",
        "passage_kind",
        "status",
        "survey_confidence"
      ],
      "properties": {
        "passage_id": {
          "$ref": "#/$defs/id"
        },
        "passage_kind": {
          "type": "string",
          "enum": [
            "horizontal",
            "slope",
            "vertical",
            "squeeze",
            "crawlway",
            "water_passage",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        },
        "width_observation": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_observation": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "measurement_unit": {
          "type": "string",
          "enum": [
            "m",
            "ft"
          ]
        },
        "survey_confidence": {
          "type": "string",
          "enum": [
            "measured",
            "estimated",
            "interpreted",
            "unknown"
          ]
        }
      }
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrance_id",
        "entrance_kind",
        "status"
      ],
      "properties": {
        "entrance_id": {
          "$ref": "#/$defs/id"
        },
        "entrance_kind": {
          "type": "string",
          "enum": [
            "natural_opening",
            "sinkhole",
            "cliff_opening",
            "shaft",
            "excavated_access",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired"
          ]
        },
        "internal_endpoint_kind": {
          "type": "string",
          "enum": [
            "chamber",
            "passage",
            "station"
          ]
        },
        "internal_endpoint_id": {
          "$ref": "#/$defs/id"
        },
        "surface_anchor_component_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id",
        "survey_frame_id"
      ],
      "properties": {
        "station_id": {
          "$ref": "#/$defs/id"
        },
        "survey_frame_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "horizontal_x": {
          "type": "number"
        },
        "horizontal_y": {
          "type": "number"
        },
        "vertical_value": {
          "type": "number"
        },
        "horizontal_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "vertical_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "measurement_source_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "chamber",
            "passage",
            "entrance",
            "station"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cave_connection_id",
        "from_endpoint",
        "to_endpoint",
        "connection_kind",
        "confidence"
      ],
      "properties": {
        "cave_connection_id": {
          "$ref": "#/$defs/id"
        },
        "from_endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "to_endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "connection_kind": {
          "type": "string",
          "enum": [
            "passage_continuity",
            "junction",
            "entrance_access",
            "survey_link",
            "other_explicit"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "measured",
            "confirmed",
            "interpreted",
            "unknown"
          ]
        }
      }
    },
    "geometry_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "role",
        "geometry_family",
        "dimension",
        "coordinate_context_id",
        "child_context",
        "asset_id",
        "asset_sha256"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "chamber_plan",
            "passage_plan",
            "cave_entrance_anchor",
            "survey_station"
          ]
        },
        "geometry_family": {
          "type": "string",
          "enum": [
            "point",
            "line_string",
            "multi_line_string",
            "polygon",
            "multi_polygon"
          ]
        },
        "dimension": {
          "const": 2
        },
        "coordinate_context_id": {
          "$ref": "#/$defs/id"
        },
        "child_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chamber_id": {
              "$ref": "#/$defs/id"
            },
            "passage_id": {
              "$ref": "#/$defs/id"
            },
            "entrance_id": {
              "$ref": "#/$defs/id"
            },
            "station_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "asset_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
