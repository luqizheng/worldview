  "vector_contract": {
    "base_fixtures": "Each vector starts from a deep copy of base_fixtures[input_source]. Base fixtures are immutable inputs.",
    "patches": "Apply patches in listed order using RFC 6902 JSON Patch semantics. Empty patches are valid when explicit external context fields define the test operation.",
    "validation_layers": {
      "schema": "Validate the patched owner payload against the pinned JSON Schema Draft 2020-12 schema only.",
      "aggregate": "Run deterministic same-owner child identity, reference, endpoint, geometry-role and domain invariant validation.",
      "schema+aggregate": "Both schema and aggregate validation must pass.",
      "publication": "Run owner-definition publication preflight using external_asset_links, asset_catalog and/or compare-and-swap context; verify rollback/no-overwrite semantics.",
      "spatial_semantics": "Evaluate supplied spatial_evidence against explicit connectivity records; geometric contact/crossing must not synthesize a connection.",
      "measurement_semantics": "Evaluate measurement_semantics against the referenced Survey Frame and datum; local relative values must not be promoted to absolute world altitude without a compatible vertical reference."
    },
    "external_asset_links": "Models typed owner Asset-link rows. Each row contains only asset_id and role; owner keys are implicit from input_source. The table has no geometry_component_id or content_hash column.",
    "asset_catalog": "Models core_asset rows as asset_id/content_hash pairs. The owner payload maps geometry_component_id to asset_id/content_hash; publication validation joins the typed link to core_asset and verifies this mapping.",
    "role_convention": "For this Building/Cave adoption profile, definition Asset-link rows for formal geometry use role=geometry_component. Component identity remains in the owner payload.",
    "expected_result": "expected=valid means the tested operation/query/interpretation succeeds; expected=invalid means it fails with the exact stable error_code. Spatial/measurement semantics vectors are not aggregate-payload invalidity tests.",
    "determinism": "A vector runner reports vector ID, schema/descriptor versions, validator build, actual error code, platform and pass/fail. JSON parsing or patch application alone is never a test pass."
  }
}
