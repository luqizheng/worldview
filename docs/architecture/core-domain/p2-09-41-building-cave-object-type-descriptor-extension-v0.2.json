  "adoption_gates": [
    "validate descriptor extension against P2-09-18 and existing P2-09-26 descriptor shape",
    "validate aggregate schemas P2-09-38 and P2-09-39",
    "execute and refine P2-09-40 vectors",
    "reconcile Asset link roles with P2-09-13 and P2-09-19",
    "define exact initial-state geometry membership and typed Asset link behavior",
    "prove deterministic definition hashing and checkpoint fingerprint coverage",
    "only then merge into a versioned Core Domain registry",
    "verify role-to-child-context oneOf constraints in P2-09-38/39 V0.3 and execute the expanded 45-vector P2-09-40 suite"
  ]
}
